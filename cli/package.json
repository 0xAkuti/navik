{
  "name": "@navik/cli",
  "version": "0.1.0",
  "description": "Deploy fully onchain websites to <project>.navik.eth",
  "type": "module",
  "bin": {
    "navik": "./dist/navik.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "navik": "node src/cli.ts",
    "bundle": "node bundle.ts",
    "prepack": "node bundle.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "bash test/e2e.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@navik/sdk": "workspace:*",
    "@types/node": "^26.6.6",
    "commander": "^15.0.0",
    "playwright": "^1.64.1",
    "rolldown": "1.2.16",
    "typescript": "^7.0.2",
    "viem": "^2.57.16"
  },
  "peerDependencies": {
    "playwright": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ]
}
