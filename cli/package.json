{
  "name": "@navik/cli",
  "version": "0.1.0",
  "description": "Deploy fully onchain websites to <project>.navik.eth",
  "type": "module",
  "bin": {
    "navik": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "navik": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "bash test/e2e.sh"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "viem": "^2.57.16",
    "@navik/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "playwright": "^1.64.1"
  },
  "peerDependencies": {
    "playwright": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
